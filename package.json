{
  "name": "entidr-monorepo",
  "version": "1.0.0",
  "description": "Entidr ERP Framework Monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/@entidr/*"
  ],
  "scripts": {
    "start": "vite",
    "server": "node server.js",
    "build": "vite build",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rimraf dist",
    "build:types": "tsc --emitDeclarationOnly",
    "prepare": "husky install",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "build:packages": "pnpm -r run build",
    "dev:packages": "pnpm -r run dev",
    "clean:packages": "pnpm -r run clean",
    "install:all": "pnpm install && pnpm build:packages",
    "setup": "pnpm install:all && npm run setup-db"
  },
  "dependencies": {
    "@hookform/resolvers": "^2.9.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-popover": "^1.0.0",
    "@radix-ui/react-select": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@types/lodash": "^4.14.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/styled-components": "^5.1.0",
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.29.0",
    "express-validator": "^7.2.1",
    "framer-motion": "^10.0.0",
    "immer": "^10.0.0",
    "lodash": "^4.17.0",
    "lucide-react": "^0.263.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "radix-ui": "^1.0.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.0",
    "react-big-calendar": "^1.6.0",
    "react-calendar": "^4.0.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.7.0",
    "react-virtualized": "^9.22.0",
    "react-window": "^1.8.0",
    "react-window-infinite-loader": "^1.0.0",
    "recharts": "^2.5.0",
    "styled-components": "^5.3.0",
    "tailwind-merge": "^1.14.0",
    "typescript": "^4.9.0",
    "yup": "^1.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "@storybook/addon-actions": "^7.0.0",
    "@storybook/addon-essentials": "^7.0.0",
    "@storybook/addon-interactions": "^7.0.0",
    "@storybook/addon-links": "^7.0.0",
    "@storybook/blocks": "^7.0.0",
    "@storybook/react": "^7.0.0",
    "@storybook/react-webpack5": "^7.0.0",
    "@storybook/testing-library": "^0.1.0",
    "@testing-library/jest-dom": "^5.16.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-plugin-named-exports-order": "^0.0.2",
    "eslint": "^8.37.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^4.4.0",
    "storybook": "^7.0.0",
    "vite": "^7.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "entidr",
    "views",
    "react",
    "typescript",
    "ui-components",
    "data-visualization",
    "drag-and-drop",
    "virtualization",
    "performance"
  ],
  "author": "Entidr Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/entidr/entidr-views.git"
  },
  "bugs": {
    "url": "https://github.com/entidr/entidr-views/issues"
  },
  "homepage": "https://github.com/entidr/entidr-views#readme"
}
